display_name = "Stealth Compound"
scene_path = "res://scenes/arena/stealth_compound.tscn"
description = "A walled courtyard with five guards who see and hear: they patrol, search and call for help. Crouch to stay quiet, break their line of sight behind the walls and crates. Climb to the catwalks and the roof, drop on a guard from above, and find the monk at the far end."
